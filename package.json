{
  "name": "@crowdin/apps-biome-config",
  "version": "1.1.0",
  "description": "Shared Biome configuration for Crowdin apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crowdin/apps-biome-config.git"
  },
  "homepage": "https://github.com/crowdin/apps-biome-config#readme",
  "bugs": {
