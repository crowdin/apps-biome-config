  },
  "keywords": [
    "crowdin",
    "crowdin-apps",
    "biome",
    "biome-config",
    "lint",
    "format"
  ],
  "files": [
    "biome.json",
    "schema.json",
    "CHANGELOG.md"
  ],
  "exports": {
    "./biome": "./biome.json"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings",
